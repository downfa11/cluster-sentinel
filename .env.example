SENTINEL_ENV=development
SENTINEL_LOG_LEVEL=INFO
SENTINEL_OPENAI_API_KEY=
SENTINEL_OPENAI_MODEL=gpt-4.1-mini
SENTINEL_SLACK_BOT_TOKEN=xoxb-your-token
SENTINEL_SLACK_APP_TOKEN=xapp-your-socket-mode-token
SENTINEL_SLACK_SIGNING_SECRET=your-signing-secret
SENTINEL_SLACK_CONTROL_CHANNELS=C_COMMAND_CHANNEL_ID
SENTINEL_SLACK_ALERT_CHANNEL_ID=C_ALERT_CHANNEL_ID
SENTINEL_SLACK_ALLOW_DMS=false
SENTINEL_SLACK_ONBOARDING_CHANNEL_ID=C_ONBOARDING_CHANNEL_ID
SENTINEL_SLACK_WELCOME_THREAD_TS=1234567890.123456
SENTINEL_GITOPS_REPO=example/cluster-config
SENTINEL_GITHUB_TOKEN=
SENTINEL_GITHUB_PR_DRY_RUN=true
SENTINEL_GITHUB_DEFAULT_BRANCH=main
SENTINEL_ADMIN_SLACK_USER_IDS='["U_ADMIN_SLACK_ID"]'
SENTINEL_OPERATOR_SLACK_USER_IDS='["U_ADMIN_SLACK_ID"]'

SENTINEL_ARGOCD_TOKEN=argocd-token
SENTINEL_GRAFANA_TOKEN=grafana-token
SENTINEL_GITOPS_TARGETS='{"commerce-api":{"path":"apps/commerce/api/deployment.yaml","repository":"ghcr.io/example/commerce-api","application":"commerce","environment":"production"}}'
SENTINEL_OPERATIONAL_TARGETS='{"commerce":{"application":"commerce","environment":"production","grafana_match":"commerce"}}'
SENTINEL_ACCESS_ROLE_GROUPS='{"gui-user":{"tailscale_group":"group:gui-users"},"dev":{"tailscale_group":"group:dev"},"operator":{"tailscale_group":"group:operator"},"admin":{"tailscale_group":"group:admin"}}'

SENTINEL_DB_READ_ENABLED=false
SENTINEL_DB_READ_TARGETS='{"commerce":{"database":"commerce","host":"home-mysql.mysql-prod.svc.cluster.local","port":"6447","username_env":"SENTINEL_COMMERCE_DB_USERNAME","password_env":"SENTINEL_COMMERCE_DB_PASSWORD"},"wargame":{"database":"wargame","host":"home-mysql.mysql-prod.svc.cluster.local","port":"6447","username_env":"SENTINEL_WARGAME_DB_USERNAME","password_env":"SENTINEL_WARGAME_DB_PASSWORD"}}'
SENTINEL_COMMERCE_DB_USERNAME=
SENTINEL_COMMERCE_DB_PASSWORD=
SENTINEL_WARGAME_DB_USERNAME=
SENTINEL_WARGAME_DB_PASSWORD=
